[Unit]
Description=Reelyard media tracker
Documentation=https://github.com/reelyard/server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=reelyard
Group=reelyard
ExecStart=/usr/bin/reelyard serve --system
# Exit code 3 asks for a restart (e.g. after the VPN address changed).
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0002

# Hardening. Reelyard writes only to its data dir unless you point the
# download/library folders elsewhere: then add them here with
#   systemctl edit reelyard  →  [Service] ReadWritePaths=/srv/media
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
